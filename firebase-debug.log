[debug] [2026-05-08T14:43:21.134Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/appdev-3d42e/rulesets {"name":"projects/appdev-3d42e/rulesets/9bd6d542-570a-4808-a170-657661a13068","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    // App-development rules:\n    // Any signed-in Firebase Auth user can use the app collections.\n    // This avoids profile-discovery deadlocks when a Firestore user profile\n    // exists by email/student id instead of by Firebase Auth UID.\n    match /users/{userId} {\n      allow read, write: if signedIn();\n    }\n\n    match /tenants/{tenantId} {\n      allow read, write: if signedIn();\n\n      match /products/{productId} {\n        allow read, write: if signedIn();\n      }\n    }\n\n    match /inventoryBatches/{batchId} {\n      allow read, write: if signedIn();\n    }\n\n    match /inventoryTransactions/{transactionId} {\n      allow read, write: if signedIn();\n    }\n\n    match /businessContacts/{contactId} {\n      allow read, write: if signedIn();\n    }\n\n    match /purchaseOrders/{purchaseOrderId} {\n      allow read, write: if signedIn();\n    }\n\n    match /sales/{saleId} {\n      allow read, write: if signedIn();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-08T14:43:20.959503Z","metadata":{"services":["cloud.firestore"]}}
